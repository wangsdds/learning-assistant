[Unit]
Description=Learning Assistant API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/learning-assistant
EnvironmentFile=/opt/learning-assistant/.env
ExecStart=/opt/learning-assistant/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
